-- ================================================
-- ANIMATION & LOGIC TOGGLES
-- ================================================
local animating = false

local function expandFullGUI()
    if animating then return end
    animating = true

    -- Fade out small frame
    tween(SmallerFrame, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {GroupTransparency = 1})
    local twSmall = tween(smallScale, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Scale = 0.85})
    twSmall.Completed:Wait()
    SmallerFrame.Visible = false

    -- Fade in full frame
    FullFrame.Visible = true
    FullFrame.GroupTransparency = 1
    fullScale.Scale = 0.85

    tween(FullFrame, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {GroupTransparency = 0})
    local twFull = tween(fullScale, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {Scale = 1})
    twFull.Completed:Wait()

    animating = false
end

local function collapseFullGUI()
    if animating then return end
    animating = true

    -- Fade out full frame
    tween(FullFrame, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {GroupTransparency = 1})
    local twFull = tween(fullScale, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Scale = 0.85})
    twFull.Completed:Wait()
    FullFrame.Visible = false

    -- Fade in small frame
    SmallerFrame.Visible = true
    SmallerFrame.GroupTransparency = 1
    smallScale.Scale = 0.85

    tween(SmallerFrame, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {GroupTransparency = 0})
    local twSmall = tween(smallScale, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {Scale = 1})
    twSmall.Completed:Wait()

    animating = false
end

-- BUTTON CONNECTIONS
PlusButton.Activated:Connect(expandFullGUI)
MinusButton.Activated:Connect(collapseFullGUI)

SetSpeedButton.Activated:Connect(function()
    local newSpeed = tonumber(SpeedInput.Text)
    if newSpeed and player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = newSpeed
            SpeedLabel.Text = "Speed: " .. newSpeed

            -- Button feedback animation
            tween(SetSpeedButton, 0.1, nil, nil, {BackgroundColor3 = Color3.fromRGB(0, 180, 80)})
            task.wait(0.12)
            tween(SetSpeedButton, 0.15, nil, nil, {BackgroundColor3 = Color3.fromRGB(0, 140, 65)})
        end
    else
        warn("Invalid speed input")
    end
end)

-- DRAGGABLE WINDOW
local UserInputService = game:GetService("UserInputService")
local dragging, dragStart, startPos

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = FullFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        FullFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
